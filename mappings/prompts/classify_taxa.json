{
  "text": {
    "format": {
      "type": "json_schema",
      "name": "taxon_normalization",
      "strict": true,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "results": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "rank": {
                  "type": "string",
                  "enum": [
                    "kingdom",
                    "phylum",
                    "class",
                    "order",
                    "family",
                    "genus",
                    "species",
                    "subspecies",
                    "variety",
                    "form",
                    "unranked"
                  ]
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                },
                "confident_ancestors": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kingdom": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "phylum": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "class": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "order": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "family": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "genus": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "kingdom",
                    "phylum",
                    "class",
                    "order",
                    "family",
                    "genus"
                  ]
                }
              },
              "required": [
                "name",
                "rank",
                "evidence",
                "confident_ancestors"
              ]
            }
          }
        },
        "required": [
          "results"
        ]
      }
    }
  }
}
