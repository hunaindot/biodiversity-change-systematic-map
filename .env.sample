# Required for any run in this repo.
OPENAI_API_KEY=<ADD YOUR OPENAI API KEY HERE>

# Core orchestrator settings. These control how many records are processed,
# which model is used, whether requests go to OpenAI, and whether evals run
# automatically after labelling completes.
ORCHESTRATOR_LIMIT_DOCS=none
ORCHESTRATOR_BATCH_SIZE=10000
ORCHESTRATOR_MODEL=gpt-5-nano-2025-08-07
ORCHESTRATOR_REASONING=high
ORCHESTRATOR_RUN_OPENAI=true
ORCHESTRATOR_SUBMISSION_MODE=batch
ORCHESTRATOR_RUN_EVALS=true

# Orchestrator paths. These point to mappings and generated artifact
# directories used by the labelling pipeline. Prompt settings live in
# checklists/mappings/repo_config.json.
ORCHESTRATOR_MAPPINGS_DIR=checklists/mappings
ORCHESTRATOR_DATASETS_DIR=data/artifacts/datasets
ORCHESTRATOR_BATCHES_DIR=data/artifacts/batches
ORCHESTRATOR_BATCH_OUTPUTS_DIR= data/artifacts/batch_outputs

# data_helpers split ratios, seed, and label roots live in
# checklists/mappings/dataset_config.json.
